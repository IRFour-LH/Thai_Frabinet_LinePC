<Window x:Class="AoiUploader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AOI Uploader" Height="800" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- Operator input + Start/Stop -->
        <Border DockPanel.Dock="Top" Background="#EEF4FB" BorderBrush="#C9D8EA" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Scan now" Click="ScanNow_Click"/>
                    <Button Content="⚙  Settings..." Click="Settings_Click" MinWidth="110"/>
                    <Button Content="Logs" Click="OpenLogs_Click" MinWidth="60"/>
                    <Button Content="Processed lists" Click="OpenProcessed_Click" Margin="0"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse Width="14" Height="14" Fill="{Binding StatusBrush}"/>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Inputs + Start -->
                <WrapPanel x:Name="InputsPanel" Orientation="Horizontal">
                    <!-- Additional inputs (Work Order...) first, then the main input used to match files -->
                    <ItemsControl x:Name="ExtrasControl" ItemsSource="{Binding Extras}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" *" Foreground="#C03030" FontWeight="SemiBold"
                                                   Visibility="{Binding Required, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBox Width="240" FontSize="18" FontWeight="SemiBold" Padding="6,4" Tag="ExtraInput"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding DataContext.IsInputEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                             KeyDown="InputBox_KeyDown"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{Binding InputLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text=" *" Foreground="#C03030" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBox x:Name="InputBox" Width="240" FontSize="18" FontWeight="SemiBold" Padding="6,4"
                                 Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsInputEditable}" KeyDown="InputBox_KeyDown"/>
                    </StackPanel>
                    <Button Content="{Binding StartStopText}" Click="StartStop_Click" IsEnabled="{Binding CanStartStop}"
                            VerticalAlignment="Bottom" MinWidth="120" FontSize="15" FontWeight="SemiBold" Padding="14,6"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Mismatch warning banner -->
        <Border DockPanel.Dock="Top" Background="#FDECEC" BorderBrush="#E07070" BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,10" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="DismissWarning_Click" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding WarningText}" Foreground="#A01818" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Info -->
        <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock><Run Text="This run: " Foreground="#5A6573"/><Run Text="{Binding RunInfo, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                <TextBlock Margin="0,2,0,0"><Run Text="Folder: " Foreground="#5A6573"/><Run Text="{Binding WatchFolder, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,2,0,0"><Run Text="API: " Foreground="#5A6573"/><Run Text="{Binding ApiInfo, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,2,0,0" Text="{Binding TodayText}" Foreground="#5A6573"/>
            </StackPanel>
        </Border>

        <!-- This run counters -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="5" Margin="0,0,-8,10">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Files sent (this run)" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding RunFiles}" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding RunQtyLabel}" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding RunQty}" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Good (G)" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding RunGood}" Style="{StaticResource CardValue}" Foreground="#2E8B3E"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="NG" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding RunNg}" Style="{StaticResource CardValue}" Foreground="#C03030"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Send failures (this run)" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding Failures}" Style="{StaticResource CardValue}" Foreground="#C77700"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Log -->
        <GroupBox DockPanel.Dock="Bottom" Header="Log" Height="160" Margin="0,10,0,0">
            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
        </GroupBox>

        <!-- Recent files -->
        <GroupBox Header="Recent files (double-click for details)">
            <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E9ED"
                      CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" MouseDoubleClick="ResultsGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="70"/>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                    <DataGridTextColumn Header="File value" Binding="{Binding FileValue}" Width="*"/>
                    <DataGridTextColumn Header="Work order / inputs" Binding="{Binding ExtrasText, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="50"/>
                    <DataGridTextColumn Header="PCB Qty" Binding="{Binding Qty}" Width="65" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="G" Binding="{Binding Good}" Width="45"/>
                    <DataGridTextColumn Header="NG" Binding="{Binding Ng}" Width="45"/>
                    <DataGridTemplateColumn Header="Result" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C03030"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Sent">
                                                    <Setter Property="Foreground" Value="#2E8B3E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="ParsedOnly">
                                                    <Setter Property="Foreground" Value="#C77700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Mismatch">
                                                    <Setter Property="Foreground" Value="#8A2BE2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Resend" Click="Resend_Click" Padding="6,1" MinWidth="0" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DockPanel>
</Window>
