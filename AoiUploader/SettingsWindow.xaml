<Window x:Class="AoiUploader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="800" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner" FontSize="13" ShowInTaskbar="False">
    <DockPanel Margin="12">

        <!-- Sample file used by preview / test on every tab -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Sample file (for preview / test):" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="SampleFileBox" Grid.Column="1"/>
            <Button Grid.Column="2" Content="Browse..." Click="BrowseSample_Click" Margin="6,0,0,0"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Click="Save_Click" MinWidth="100" FontWeight="SemiBold"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="0"/>
        </StackPanel>

        <TabControl>
            <!-- ================= GENERAL ================= -->
            <TabItem Header="  General  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,4"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Folder" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Text="Watch folder" Style="{StaticResource FormLabel}"/>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseFolder_Click" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding General.WatchFolder}"/>
                        </DockPanel>

                        <TextBlock Grid.Row="2" Text="File pattern" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.FilePattern}" Width="120"/>
                            <CheckBox Content="Include subfolders" IsChecked="{Binding General.IncludeSubfolders}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Scan every (seconds)" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.ScanIntervalSeconds}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Backup scan. New files are also detected instantly by the folder watcher."/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="File stable (seconds)" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.FileStableSeconds}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Wait until the file has not changed for this long (AOI finished writing)."/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="Ignore files older than (days)" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.IgnoreFilesOlderThanDays}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="0 = send all files. Use e.g. 1 to skip old history on first start."/>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="File format" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>

                        <TextBlock Grid.Row="7" Text="Recipe line no." Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.RecipeLineNumber}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Line that holds the recipe name ({{Recipe}}). 0 = none."/>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Text="Header line no." Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.HeaderLineNumber}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Line with the column names."/>
                        </StackPanel>

                        <TextBlock Grid.Row="9" Text="Data starts at line no." Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.DataStartLineNumber}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Empty lines and |----| separator lines are skipped."/>
                        </StackPanel>

                        <TextBlock Grid.Row="10" Text="Delimiter" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.Delimiter}" Width="80"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Separator of data values. Use \t for TAB."/>
                        </StackPanel>

                        <TextBlock Grid.Row="11" Text="Date format in file" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.DateFormat}" Width="160"/>
                            <TextBlock Style="{StaticResource Hint}" Text="For columns of type Date. e.g. yyyyMMddHHmmss"/>
                        </StackPanel>

                        <TextBlock Grid.Row="12" Text="Date format sent to API" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.OutputDateFormat}" Width="160"/>
                            <TextBlock Style="{StaticResource Hint}" Text="e.g. yyyy-MM-ddTHH:mm:ss or yyyy-MM-dd HH:mm:ss"/>
                        </StackPanel>

                        <TextBlock Grid.Row="13" Text="Result field / Good values" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding General.ResultField}" Width="120"/>
                            <TextBox Text="{Binding General.GoodValues}" Width="120" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Field name (from Column Mapping) with pass/fail, and values that mean GOOD (comma separated). Others = NG."/>
                        </StackPanel>

                        <TextBlock Grid.Row="14" Text="PCB qty calculation" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="QtyByRowRadio" Content="By row" GroupName="QtyMode" VerticalAlignment="Center" Checked="QtyMode_Changed"/>
                            <RadioButton x:Name="QtyByDistinctRadio" Content="By distinct value of field:" GroupName="QtyMode" VerticalAlignment="Center" Margin="18,0,6,0" Checked="QtyMode_Changed"/>
                            <TextBox x:Name="QtyFieldBox" Text="{Binding General.QtyField}" Width="120"/>
                            <TextBlock Style="{StaticResource Hint}" Text="e.g. BarcodeID. Rows with the same value = 1 PCB (NG if any of its rows is NG)."/>
                        </StackPanel>

                        <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Text="Program" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>

                        <TextBlock Grid.Row="16" Text="Processed lists folder" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,8,10,0"/>
                        <StackPanel Grid.Row="16" Grid.Column="1" Margin="0,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseProcessed_Click" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding General.ProcessedFolder}"
                                         ToolTip="One list per day (yyyy-MM-dd.txt) of files sent to the API. Relative path = next to the program."/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Delete lists older than" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding General.KeepProcessedDays}" Width="60"/>
                                <TextBlock Text="days" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="0 = keep forever. Only the program's daily list files (yyyy-MM-dd.txt) are deleted - AOI result files are NEVER deleted."/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="17" Text="Log folder" Style="{StaticResource FormLabel}"/>
                        <DockPanel Grid.Row="17" Grid.Column="1" Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseLogFolder_Click" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding General.LogFolder}" ToolTip="Relative path = next to the program."/>
                        </DockPanel>

                        <StackPanel Grid.Row="18" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Content="Start program with Windows" IsChecked="{Binding General.StartWithWindows}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= OPERATOR INPUT ================= -->
            <TabItem Header="  Operator Input  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#4A5563" Margin="0,0,0,12"
                                   Text="The operator enters the Work Order and a value used to match files (Product Name) on the main window and presses Start. Only files that belong to that value are sent to the API. Files for another value are skipped (not marked as processed) and a warning is shown."/>

                        <TextBlock Grid.Row="1" Text="Label shown to operator" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox Text="{Binding Input.Label}" Width="200"/>
                            <TextBlock Style="{StaticResource Hint}" Text="e.g. Recipe, Work Order, Product Name"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Match the value with" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <RadioButton x:Name="MatchFileNameRadio" GroupName="Match" Checked="Match_Changed" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="File name, part before separator" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SeparatorBox" Text="{Binding Input.FileNameSeparator}" Width="40" Margin="8,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="B613351X1105_20261113110752265.TST  →  B613351X1105"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MatchRecipeLineRadio" GroupName="Match" Checked="Match_Changed" Margin="0,6,0,2">
                                <TextBlock Text="Recipe line of the file (General tab → Recipe line no.)"/>
                            </RadioButton>
                            <RadioButton x:Name="MatchFieldRadio" GroupName="Match" Checked="Match_Changed" Margin="0,6,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Data field (API Field Name in Column Mapping)" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MatchFieldBox" Text="{Binding Input.MatchField}" Width="140" Margin="8,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="All rows must have this value."/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Options" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,8,10,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                            <CheckBox Content="Only process files created after Start is pressed" IsChecked="{Binding Input.OnlyFilesAfterStart}" Margin="0,2"/>
                            <CheckBox Content="Warn operator (banner + sound) when a file for another value arrives" IsChecked="{Binding Input.WarnOnMismatch}" Margin="0,4"/>
                            <CheckBox Content="Start automatically with the last entered value when the program opens" IsChecked="{Binding Input.AutoStartWithLastValue}" Margin="0,2"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Test with sample file" Style="{StaticResource FormLabel}" Margin="0,18,10,0"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBox x:Name="TestInputBox" Width="200"/>
                            <Button Content="Check match" Click="CheckMatch_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="MatchResultText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="6" Text="Additional inputs" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,22,10,0"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,22,0,0">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Extra values the operator enters before Start, e.g. Work Order. They are NOT used to match files - they are sent to the API. Use the Key in the body template, e.g. &quot;workOrder&quot;: &quot;{{WorkOrder}}&quot;."/>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                    <Button Content="+ Add" Click="AddExtra_Click" Margin="0,0,0,4"/>
                                    <Button Content="Remove" Click="RemoveExtra_Click" Margin="0"/>
                                </StackPanel>
                                <DataGrid x:Name="ExtrasGrid" Height="130" AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E9ED">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Key (template placeholder)" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Label shown to operator" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                        <DataGridCheckBoxColumn Header="Remember last value" Binding="{Binding RememberLastValue, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= COLUMN MAPPING ================= -->
            <TabItem Header="  Column Mapping  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap" Foreground="#4A5563" Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="API Field Name"/><Run Text=" = name sent to the API.  "/>
                        <Run FontWeight="SemiBold" Text="File Header"/><Run Text=" = column name in the AOI file (looked up first).  "/>
                        <Run FontWeight="SemiBold" Text="Column Index"/><Run Text=" = position starting at 0, used if the header is not found.  Untick "/>
                        <Run FontWeight="SemiBold" Text="Send"/><Run Text=" to leave a column out of the API."/>
                    </TextBlock>

                    <DataGrid x:Name="MappingGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E9ED">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="API Field Name" Binding="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="File Header" Binding="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Column Index" Binding="{Binding ColumnIndex}" Width="100"/>
                            <DataGridComboBoxColumn x:Name="DataTypeColumn" Header="Type" SelectedItemBinding="{Binding DataType}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Send" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add" Click="AddMapping_Click"/>
                        <Button Content="Remove" Click="RemoveMapping_Click"/>
                        <Button Content="▲ Up" Click="MoveUp_Click" MinWidth="60"/>
                        <Button Content="▼ Down" Click="MoveDown_Click" MinWidth="60"/>
                        <Separator Margin="8,0" Width="1"/>
                        <Button Content="Detect from sample file" Click="DetectMapping_Click"/>
                        <Button Content="Preview" Click="PreviewMapping_Click" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock x:Name="PreviewInfo" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,4" Foreground="#30405A"/>

                    <DataGrid x:Name="PreviewGrid" Grid.Row="4" IsReadOnly="True" AutoGenerateColumns="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E9ED"/>
                </Grid>
            </TabItem>

            <!-- ================= API ================= -->
            <TabItem Header="  API  ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: connection + template -->
                    <DockPanel Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Top">
                            <CheckBox Content="Enable sending to API" IsChecked="{Binding Api.Enabled}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="URL" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding Api.Url}" Margin="0,3"/>

                                <TextBlock Grid.Row="1" Text="Method" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="MethodCombo" IsEditable="True" Text="{Binding Api.Method}" Width="90"/>
                                    <TextBlock Text="Content-Type" Style="{StaticResource FormLabel}" Margin="14,0,8,0"/>
                                    <TextBox Text="{Binding Api.ContentType}" Width="150"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Send mode" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="SendModeCombo" SelectedItem="{Binding Api.SendMode}" Width="90"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="PerFile = 1 call with all rows. PerRow = 1 call per row."/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="Timeout (s)" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox Text="{Binding Api.TimeoutSeconds}" Width="50"/>
                                    <TextBlock Text="Retries" Style="{StaticResource FormLabel}" Margin="14,0,8,0"/>
                                    <TextBox Text="{Binding Api.RetryCount}" Width="40"/>
                                    <TextBlock Text="Retry failed file after (s)" Style="{StaticResource FormLabel}" Margin="14,0,8,0"/>
                                    <TextBox Text="{Binding Api.RetryDelaySeconds}" Width="50"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="Success if" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="HTTP 2xx and response contains" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Api.SuccessContains}" Width="140" ToolTip="Leave empty to accept any 2xx response"/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Text="Headers" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,3">
                                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                        <Button Content="+" Click="AddHeader_Click" MinWidth="30" Margin="0,0,0,4"/>
                                        <Button Content="−" Click="RemoveHeader_Click" MinWidth="30" Margin="0"/>
                                    </StackPanel>
                                    <DataGrid x:Name="HeadersGrid" Height="76" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E9ED">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name (e.g. Authorization, X-Api-Key)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>

                            <DockPanel Margin="0,10,0,4">
                                <Button DockPanel.Dock="Right" Content="Load default template" Click="DefaultTemplate_Click" Margin="0"/>
                                <TextBlock Text="Body template" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <Expander DockPanel.Dock="Bottom" Header="Available placeholders" Margin="0,6,0,0">
                            <TextBlock x:Name="PlaceholderHelpText" FontFamily="Consolas" FontSize="11"
                                       Foreground="#4A5563" Margin="4" TextWrapping="Wrap"/>
                        </Expander>
                        <TextBox Text="{Binding Api.PayloadTemplate}" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>

                    <!-- Right: preview / test -->
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Preview body" Click="PreviewBody_Click" FontWeight="SemiBold"/>
                            <Button x:Name="TestSendButton" Content="Test send (sample file)" Click="TestSend_Click"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Test send posts the sample file to the URL now. It is NOT recorded in the processed list."/>
                        <TextBox x:Name="ApiOutputBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalContentAlignment="Top" TextWrapping="NoWrap" Background="#FAFBFC"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
